{
  "name": "@takinprofit/errorset",
  "version": "0.3.0",
  "description": "Domain-bound, type-safe error handling for TypeScript inspired by Zig's error sets",
  "keywords": [
    "error",
    "error-handling",
    "errorset",
    "typescript",
    "type-safe",
    "zig",
    "result",
    "either",
    "domain-driven"
  ],
  "homepage": "https://github.com/g5becks/errorset#readme",
  "bugs": {
    "url": "https://github.com/g5becks/errorset/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/g5becks/errorset.git"
  },
  "license": "MIT",
  "author": "g5becks",
  "sideEffects": [
    "./src/*.ts"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "bench": "bun bench/errorset.bench.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target node && bun run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "lint": "bunx ultracite check",
    "lint:fix": "bunx ultracite fix",
    "prepare": "lefthook install",
    "prepublishOnly": "bun run typecheck && bun run test:types && bun run test && bun run test:consumer",
    "test": "bun test",
    "test:consumer": "bun run build && bun scripts/smoke-consumer.ts",
    "test:types": "tsc --noEmit -p tests/types/tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/bun": "1.4.4",
    "backlog.md": "1.55.3",
    "expect-type": "1.4.0",
    "lefthook": "2.2.2",
    "typescript": "~7.0.2",
    "ultracite": "8.1.1"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22"
  }
}
