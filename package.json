{
  "name": "@takinprofit/errorset",
  "version": "0.3.0",
  "description": "Domain-bound, type-safe error handling for TypeScript inspired by Zig's error sets",
  "author": "g5becks",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "error",
    "error-handling",
    "errorset",
    "typescript",
    "type-safe",
    "zig",
    "result",
    "either",
    "domain-driven"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/g5becks/errorset.git"
  },
  "bugs": {
    "url": "https://github.com/g5becks/errorset/issues"
  },
  "homepage": "https://github.com/g5becks/errorset#readme",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/bun": "latest",
    "backlog.md": "1.55.3",
    "expect-type": "1.4.0",
    "lefthook": "^2.0.13",
    "typescript": "~7.0.2",
    "ultracite": "7.0.8"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "scripts": {
    "prepare": "lefthook install",
    "build": "bun build ./src/index.ts --outdir ./dist --target node && bun run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "test:types": "tsc --noEmit -p tests/types/tsconfig.json",
    "lint": "bunx ultracite check --type-aware",
    "lint:fix": "bunx ultracite fix --type-aware",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun run test:types && bun run test && bun run build"
  }
}
